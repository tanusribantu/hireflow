rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null && (resource.data.candidateId == request.auth.uid || resource.data.recruiterId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
