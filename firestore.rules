rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRecruiter() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter';
    }

    function isJobRecruiter(jobId) {
      return isSignedIn() && exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      // Any signed-in user may read user profiles (adjust if you want public reads)
      allow read: if isSignedIn();

      // Only the authenticated user may create or update their own profile
      allow create, update: if isSignedIn() && request.auth.uid == userId;

      // No client-side deletes
      allow delete: if false;
    }

    // Job postings
    match /jobs/{jobId} {
      // Jobs are public
      allow read: if true;

      // Only recruiters may create jobs
      allow create: if isRecruiter();

      // Only the owning recruiter may update or delete
      allow update, delete: if isSignedIn() && resource.data.recruiterId == request.auth.uid;
    }

    // Applications: creation must go through server-side API to enforce uniqueness
    match /applications/{applicationId} {
      // Only the owning candidate or the recruiter for the job may read an application
      allow get: if isSignedIn() && (resource.data.candidateId == request.auth.uid || isJobRecruiter(resource.data.jobId));

      // Prevent client-side creation/updates/deletes — server API should perform those operations
      allow create, update, delete: if false;

      // Listing applications from client is disabled; use server-side queries if needed
      allow list: if false;
    }

    // Deny any other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.recruiterId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null && (resource.data.candidateId == request.auth.uid || resource.data.recruiterId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
