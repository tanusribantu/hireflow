rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isRecruiter() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter';
    }
    function isJobRecruiter(jobId) {
      return isSignedIn() && exists(/databases/$(database)/documents/jobs/$(jobId)) &&
        get(/databases/$(database)/documents/jobs/$(jobId)).data.recruiterId == request.auth.uid;
    }
    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    // Job postings
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isRecruiter();
      allow update, delete: if isSignedIn() && resource.data.recruiterId == request.auth.uid;
    }
    // Applications
    match /applications/{applicationId} {
      allow get: if isSignedIn() &&
        (resource.data.candidateId == request.auth.uid ||
         isJobRecruiter(resource.data.jobId));
      allow create, update, delete: if false;
      // All application collection reads go through trusted server API routes.
      allow list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}